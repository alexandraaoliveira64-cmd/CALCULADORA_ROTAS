<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Viagem Lucrativa</title>
    <style>
        :root {
            --primary: #1e4620;
            --bg: #f3f4f6;
            --card: #ffffff;
            --text: #1f2937;
        }
        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: var(--bg); color: var(--text); margin: 0; padding: 12px; display: flex; justify-content: center; }
        .app-container { width: 100%; max-width: 480px; background: var(--card); padding: 18px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
        h1 { text-align: center; color: var(--primary); margin: 0 0 20px 0; font-size: 22px; font-weight: 800; }
        .group { margin-bottom: 14px; }
        label { display: block; font-weight: 700; margin-bottom: 5px; font-size: 13px; color: #4b5563; }
        input, select { width: 100%; padding: 12px; border: 2px solid #d1d5db; border-radius: 8px; font-size: 16px; background: #fff; outline: none; }
        input:focus, select:focus { border-color: #2e7d32; }
        .row { display: flex; gap: 8px; }
        .row .group { flex: 1; }
        .btn-calc { width: 100%; background: #2e7d32; color: white; border: none; padding: 15px; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; margin-top: 5px; }
        .btn-calc:active { background: #1b5e20; }
        
        /* Aba de Negociação Separada */
        .negotiation-box { margin-top: 20px; padding: 15px; border-radius: 12px; background: #f8fafc; border: 2px solid #e2e8f0; display: none; }
        .box-title { font-size: 15px; font-weight: bold; color: #334155; margin-bottom: 12px; text-align: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        
        /* Cards de Preço */
        .price-card { padding: 12px; border-radius: 8px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; border: 2px solid transparent; transition: 0.2s; }
        .price-card:hover { transform: scale(1.01); }
        .price-card.selected { border-color: #25d366; box-shadow: 0 0 8px rgba(37, 211, 102, 0.5); }
        .price-info { display: flex; flex-direction: column; }
        .price-label { font-size: 12px; font-weight: bold; text-transform: uppercase; }
        .price-desc { font-size: 11px; opacity: 0.8; }
        .price-value { font-size: 20px; font-weight: 800; }
        
        .card-max { background-color: #e0f2fe; color: #0369a1; border-left: 5px solid #0284c7; }
        .card-ideal { background-color: #dcfce7; color: #15803d; border-left: 5px solid #16a34a; }
        .card-min { background-color: #fee2e2; color: #b91c1c; border-left: 5px solid #dc2626; }
        
        .alert-prejuizo { font-size: 11px; color: #b91c1c; text-align: center; font-weight: bold; margin-top: 4px; display: block; }
        
        .cost-summary { font-size: 12px; color: #64748b; background: #fff; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2e8f0; margin-top: 10px; }
        .cost-summary div { display: flex; justify-content: space-between; margin-bottom: 2px; }

        /* Botão do WhatsApp */
        .btn-whatsapp { width: 100%; background: #25d366; color: white; border: none; padding: 14px; border-radius: 8px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 15px; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .btn-whatsapp:active { background: #128c7e; }
        .instrucao-whats { font-size: 11px; color: #64748b; text-align: center; margin-top: 4px; font-style: italic; display: block; }
    </style>
</head>
<body>

<div class="app-container">
    <h1>Calculadora de Viagem</h1>

    <div class="group">
        <label>Nome do Cliente (Opcional)</label>
        <input type="text" id="nomeCliente" placeholder="Ex: João Silva">
    </div>
    
    <div class="row">
        <div class="group">
            <label>Combustível</label>
            <select id="combustivel" onchange="atualizarCombustivel()">
                <option value="gasolina">Gasolina</option>
                <option value="alcool">Álcool</option>
            </select>
        </div>
        <div class="group">
            <label>Preço Litro (R$)</label>
            <input type="number" id="precoLitro" step="0.01" value="5.80">
        </div>
    </div>

    <div class="row">
        <div class="group">
            <label>Como vai cobrar?</label>
            <select id="tipoCobranca" onchange="mudarLabelMedida()">
                <option value="km">Por KM Rodado</option>
                <option value="hora">Por Hora de Viagem</option>
            </select>
        </div>
        <div class="group">
            <label id="labelMedida">Total de KM (Só Ida)</label>
            <input type="number" id="medida" placeholder="Ex: 80">
        </div>
    </div>

    <div class="group">
        <label>Tipo da Viagem / Logística</label>
        <select id="tipoLogistica">
            <option value="normal">Normal (Vou e volto direto com o cliente)</option>
            <option value="volta_vazio">Deixar Cliente (Volta com carro vazio)</option>
            <option value="leva_busca">Leva Hoje e Busca dias depois (2 viagens completas)</option>
        </select>
    </div>

    <div class="group">
        <label>Gastos da Viagem (Pedágios/Estacionamento)</label>
        <input type="number" id="pedagios" value="0">
    </div>

    <button class="btn-calc" onclick="calcularTudo()">CALCULAR MARGENS</button>

    <!-- ABA SEPARADA DE NEGOCIAÇÃO -->
    <div class="negotiation-box" id="abaNegociacao">
        <div class="box-title">Painel de Negociação</div>
        
        <p style="font-size: 12px; margin: 0 0 10px 0; text-align: center; color: #64748b;">Toque no valor que combinou para enviar no WhatsApp:</p>

        <!-- PREÇO MÁXIMO -->
        <div class="price-card card-max selected" id="cardM" onclick="selecionarPreco('max')">
            <div class="price-info">
                <span class="price-label">Preço Máximo (Melhor Lucro)</span>
                <span class="price-desc">Comece oferecendo este valor</span>
            </div>
            <div class="price-value" id="valMax">R$ 0,00</div>
        </div>

        <!-- PREÇO IDEAL -->
        <div class="price-card card-ideal" id="cardI" onclick="selecionarPreco('ideal')">
            <div class="price-info">
                <span class="price-label">Preço Justo (Ideal)</span>
                <span class="price-desc">Desconto bom e seguro</span>
            </div>
            <div class="price-value" id="valIdeal">R$ 0,00</div>
        </div>

        <!-- PREÇO MÍNIMO -->
        <div class="price-card card-min" id="cardMin" onclick="selecionarPreco('min')">
            <div class="price-info">
                <span class="price-label">Preço Mínimo (Limite)</span>
                <span class="price-desc">Menos que isso é prejuízo</span>
            </div>
            <div class="price-value" id="valMin">R$ 0,00</div>
        </div>
        <span class="alert-prejuizo">⚠️ ABAIXO DO MÍNIMO É PREJUÍZO REAL!</span>

        <!-- ENVIAR ORÇAMENTO -->
        <button class="btn-whatsapp" onclick="enviarWhatsApp()">
            💬 ENVIAR VALOR SELECIONADO
        </button>
        <span class="instrucao-whats">O texto vai abrir pronto no seu WhatsApp</span>

        <!-- RESUMO INTERNO PARA O MOTORISTA SABER -->
        <div class="cost-summary">
            <div><span>Combustível total gasto:</span><strong id="resComb">R$ 0,00</strong></div>
            <div><span>Pedágios / Custos Extras:</span><strong id="resPedagio">R$ 0,00</strong></div>
            <div><span>KM totais rodados no total:</span><strong id="resKmTotal">0 KM</strong></div>
        </div>
    </div>
</div>

<script>
    // Variáveis globais para armazenar os valores calculados
    let valores = { max: 0, ideal: 0, min: 0 };
    let precoSelecionadoTipo = 'max';

    // Mudar os valores padrão ao alterar combustível
    function atualizarCombustivel() {
        const comb = document.getElementById("combustivel").value;
        const precoInput = document.getElementById("precoLitro");
        if (comb === "gasolina") {
            precoInput.value = "5.80";
        } else {
            precoInput.value = "4.10";
        }
    }

    // Altera o rótulo do campo com base no modelo de cobrança escolhido
    function mudarLabelMedida() {
        const tipo = document.getElementById("tipoCobranca").value;
        const label = document.getElementById("labelMedida");
        const medidaInput = document.getElementById("medida");
        if (tipo === "km") {
            label.innerText = "Total de KM (Só Ida)";
            medidaInput.placeholder = "Ex: 80";
        } else {
            label.innerText = "Tempo Estimado (Horas)";
            medidaInput.placeholder = "Ex: 3";
        }
    }

    function calcularTudo() {
        // Captura de Inputs
        const precoLitro = parseFloat(document.getElementById("precoLitro").value) || 0;
        const tipoCobranca = document.getElementById("tipoCobranca").value;
        const medida = parseFloat(document.getElementById("medida").value) || 0;
        const tipoLogistica = document.getElementById("tipoLogistica").value;
        const pedagios = parseFloat(document.getElementById("pedagios").value) || 0;
        const combustivelTipo = document.getElementById("combustivel").value;

        // 1. Média de Consumo Estimada do Carro Particular
        const consumoPorLitro = (combustivelTipo === "gasolina") ? 11 : 8.5; 

        let kmTotalRodado = 0;
        let tempoHoras = 0;

        // 2. Definir KM total rodado com base no tipo de cobrança e logística
        if (tipoCobranca === "km") {